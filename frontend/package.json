{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test tests/reader-hardening.test.mjs",
    "test:hardening": "node --test tests/reader-hardening.test.mjs",
    "mobile:dev": "vite --config mobile/vite.config.ts",
    "mobile:build": "vite build --config mobile/vite.config.ts --configLoader runner",
    "mobile:sync": "npm run mobile:build && cap sync",
    "android:apk": "npm run mobile:sync && cd android && gradlew.bat assembleDebug",
    "ios:sync": "npm run mobile:sync && cap sync ios",
    "ios:ipa": "npm run ios:sync && xcodebuild -workspace ios/App/App.xcworkspace -scheme App -configuration Release -archivePath build/BookSync.xcarchive archive && xcodebuild -exportArchive -archivePath build/BookSync.xcarchive -exportOptionsPlist ios/ExportOptions.plist -exportPath build/ipa",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "ajv": "^8.20.0",
    "busboy": "^1.6.0",
    "dompurify": "^3.4.13",
    "drizzle-orm": "0.45.2",
    "fast-uri": "^3.1.5",
    "fflate": "^0.8.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
